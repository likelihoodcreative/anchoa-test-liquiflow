<div class="padding-global">
          <div class="container-large">
            <div class="padding-section-large">
              <div class="product_component">
                <div id="w-node-_6e539f9d-c86a-1758-6638-f3769de85d9e-4e4cbfad" class="margin-xxlarge margin-bottom">
                  <div class="product_heading-wrapper">
                    <div class="product_heading">
                      <div class="max-width-large">
                        <div class="margin-bottom margin-xsmall-2">
                          <div class="text-style-tagline">Comprar</div>
                        </div>
                        <div class="margin-bottom margin-xsmall-2">
                          <h2 class="heading-style-h2-4">
{{ section.settings.text_heading }}
</h2>
                        </div>
                        <p class="text-size-medium-5">
{{ section.settings.text_paragraph }}
</p>
                        <p class="text-size-regular-4 font-reforma_blanca">
{{ section.settings.text_paragraph }}
</p>
                      </div>
                    </div>
                  </div>
                </div>
                <div>
                  <div class="product_list product8_list">
                    {% for product in section.settings.collection_collection.products limit: section.settings.collection_collection_limit %}
<div class="product_list-item">
    
                      
    {% render 'product_item', product: product %}
    
                    
</div>
{% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Featured products",
    "class": "section_product",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Kiosco online"
        },
        {
            "id": "text_paragraph",
            "type": "text",
            "label": "Paragraph",
            "default": "Nuestro kiosco online opera desde Argentina, podemos hacer envios internacionales, pero aconsejamos que primero <a href=\"#\">consultes la lista de distribuidores,<\/a> ya que es posible que estemos disponibles con entrega local m\u00e1s cercano a donde te encuentres."
        },
        {
            "id": "collection_collection",
            "type": "collection",
            "label": "Collection"
        },
        {
            "type": "range",
            "id": "collection_collection_limit",
            "min": 1,
            "max": 99,
            "step": 1,
            "label": "Limit: Collection",
            "default": 6
        }
    ],
    "presets": [
        {
            "name": "Featured products",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}