/* ============================================
   Shopify Cookie Banner &rarr; Anchoa Brand Overrides
   Paste into your Shopify theme's custom CSS
   ============================================ */
/* --- Banner container --- */
#shopify-pc__banner.shopify-pc__banner__dialog {
  background-color: var(--anchoa-shopify_anchoa---anchoa-brand--f2ebfb, #f2ebfb) !important;
  border: none !important;
  border-top: 1px solid var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  box-shadow: none !important;
  padding: 2rem !important;
  font-family: objektiv-mk2, sans-serif !important;
  font-size: 1rem !important;
  line-height: 1.5 !important;
  color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  border-radius: 0 !important;
  max-height: none !important;
}
/* --- Inner wrapper: horizontal layout on desktop --- */
#shopify-pc__banner .shopify-pc__banner__wrapper {
  display: flex !important;
  align-items: center !important;
  gap: 2rem !important;
  max-width: 100% !important;
  flex-wrap: wrap !important;
}
/* --- Body text area --- */
#shopify-pc__banner .shopify-pc__banner__body {
  flex: 1 1 0% !important;
  min-width: 0 !important;
}
/* --- Hide the heading to match the target (text-only) --- */
#shopify-pc__banner .shopify-pc__banner__body h2 {
  display: none !important;
}
/* --- Paragraph text --- */
#shopify-pc__banner .shopify-pc__banner__body p {
  font-size: 0.875rem !important;
  line-height: 1.5 !important;
  color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  margin: 0 !important;
}
/* --- Privacy policy link --- */
#shopify-pc__banner .shopify-pc__banner__body a {
  color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  text-decoration: underline !important;
}
#shopify-pc__banner .shopify-pc__banner__body a:hover {
  opacity: 0.7 !important;
}
/* --- Button container --- */
#shopify-pc__banner .shopify-pc__banner__btns {
  display: flex !important;
  flex-flow: row !important;
  justify-content: flex-end !important;
  align-items: flex-start !important;
  gap: 1rem !important;
  flex-shrink: 0 !important;
}
/* --- Shared button base styles --- */
#shopify-pc__banner .shopify-pc__banner__btns button {
  font-family: objektiv-mk2, sans-serif !important;
  font-size: 0.75rem !important;
  line-height: 1 !important;
  padding: 0.5rem 1rem !important;
  border-radius: 0 !important;
  cursor: pointer !important;
  text-transform: none !important;
  font-weight: 400 !important;
  letter-spacing: normal !important;
  white-space: nowrap !important;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease !important;
}
/* --- Accept button (primary / filled) --- */
#shopify-pc__banner .shopify-pc__banner__btn-accept {
  background-color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  color: var(--anchoa-shopify_anchoa---anchoa-brand--fbf9fe, #fbf9fe) !important;
  border: 1px solid var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
}
#shopify-pc__banner .shopify-pc__banner__btn-accept:hover {
  background-color: var(--anchoa-shopify_anchoa---anchoa-brand--21226f, #21226f) !important;
  border-color: var(--anchoa-shopify_anchoa---anchoa-brand--21226f, #21226f) !important;
}
/* --- Manage preferences button (secondary / outline) --- */
#shopify-pc__banner .shopify-pc__banner__btn-manage-prefs {
  background-color: transparent !important;
  color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  border: 1px solid var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
}
#shopify-pc__banner .shopify-pc__banner__btn-manage-prefs:hover {
  background-color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  color: var(--anchoa-shopify_anchoa---anchoa-brand--fbf9fe, #fbf9fe) !important;
}
/* --- Decline button (secondary / outline) --- */
#shopify-pc__banner .shopify-pc__banner__btn-decline {
  background-color: transparent !important;
  color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  border: 1px solid var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
}
#shopify-pc__banner .shopify-pc__banner__btn-decline:hover {
  background-color: var(--anchoa-shopify_anchoa---anchoa-brand--020659, #020659) !important;
  color: var(--anchoa-shopify_anchoa---anchoa-brand--fbf9fe, #fbf9fe) !important;
}
/* --- Tablet: buttons move above text --- */
@media screen and (max-width: 991px) {
  #shopify-pc__banner .shopify-pc__banner__btns {
    order: -9999 !important;
  }
}
/* --- Small tablet / large phone: stack buttons vertically --- */
@media screen and (max-width: 767px) {
  #shopify-pc__banner .shopify-pc__banner__wrapper {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 1rem !important;
  }
  #shopify-pc__banner .shopify-pc__banner__btns {
    flex-flow: column !important;
    align-items: stretch !important;
  }
}
/* --- Phone: center button text --- */
@media screen and (max-width: 479px) {
  #shopify-pc__banner .shopify-pc__banner__btns {
    flex-flow: column !important;
    align-items: stretch !important;
    text-align: center !important;
  }
}
